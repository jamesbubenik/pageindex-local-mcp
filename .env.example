# =============================================================================
# pageindex-local-mcp — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# =============================================================================

# Path to your local clone of https://github.com/VectifyAI/PageIndex
PAGEINDEX_REPO_PATH=/home/user/PageIndex

# Python executable (must have PageIndex requirements installed)
# Examples:
#   python3
#   python
#   /home/user/miniconda3/envs/pageindex/bin/python
#   C:\Users\user\miniconda3\envs\pageindex\python.exe
PAGEINDEX_PYTHON=python3

# Directory where this MCP server stores its workspace artifacts
# Defaults to ~/.pageindex-local-mcp if not set
PAGEINDEX_WORKSPACE=/home/user/.pageindex-local-mcp

# Default model name passed to PageIndex generation.
# For local endpoints, this should match the model loaded in your LLM server.
PAGEINDEX_MODEL=local-model

# OpenAI-compatible local LLM endpoint base URL (no trailing slash)
# Examples:
#   http://127.0.0.1:1234/v1   (LM Studio)
#   http://127.0.0.1:11434/v1  (Ollama with openai-compat layer)
#   http://127.0.0.1:8000/v1   (vLLM)
PAGEINDEX_LLM_BASE_URL=http://127.0.0.1:1234/v1

# API key for the local endpoint (most local servers accept any non-empty value)
PAGEINDEX_LLM_API_KEY=lm-studio

# LLM request timeout in milliseconds (default: 120000 = 2 minutes)
PAGEINDEX_LLM_TIMEOUT_MS=120000

# Max time allowed for a PageIndex Python subprocess (indexing) in milliseconds.
# Increase this for very large PDFs or slow machines. Default: 600000 (10 minutes).
# This directly controls how long the MCP tool call runs before the server gives up.
# If LM Studio shows "MCP error -32001: Request timed out", increase this value AND
# set a matching "timeout" (in seconds) in your mcp.json server config.
PAGEINDEX_TOOL_TIMEOUT_MS=600000

# ---- PageIndex generation options (applied as defaults; can be overridden per-call) ----

# Pages to check for table of contents (PDF only)
PAGEINDEX_TOC_CHECK_PAGES=20

# Maximum pages per tree node (PDF only)
PAGEINDEX_MAX_PAGES_PER_NODE=10

# Maximum tokens per tree node
PAGEINDEX_MAX_TOKENS_PER_NODE=20000

# ---- Security ----

# Semicolon-separated (Windows) or colon-separated (macOS/Linux) list of allowed root directories.
# If set, only files under these roots can be indexed.
# Leave empty to allow all paths (not recommended in shared environments).
# Windows example:  C:\Users\user\Documents;C:\Users\user\Downloads
# macOS/Linux example: /home/user/Documents:/home/user/Downloads
PAGEINDEX_ALLOWED_ROOTS=

# ---- Registry ----

# Storage backend: json (default) or sqlite (future)
PAGEINDEX_REGISTRY_BACKEND=json

# ---- Logging ----

# Log level: debug | info | warn | error
PAGEINDEX_LOG_LEVEL=info
