# Sample .env for pageindex-local-mcp
# Copy to the project root as .env and adjust paths.

# --- Required ---
PAGEINDEX_REPO_PATH=/home/user/PageIndex
PAGEINDEX_PYTHON=python3

# --- Workspace ---
PAGEINDEX_WORKSPACE=/home/user/.pageindex-local-mcp

# --- LM Studio (local LLM) ---
PAGEINDEX_LLM_BASE_URL=http://127.0.0.1:1234/v1
PAGEINDEX_LLM_API_KEY=lm-studio
PAGEINDEX_MODEL=mistral-7b-instruct-v0.3

# --- Ollama (alternative) ---
# PAGEINDEX_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PAGEINDEX_LLM_API_KEY=ollama
# PAGEINDEX_MODEL=llama3

# --- vLLM (alternative) ---
# PAGEINDEX_LLM_BASE_URL=http://127.0.0.1:8000/v1
# PAGEINDEX_LLM_API_KEY=none
# PAGEINDEX_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- PageIndex options ---
PAGEINDEX_TOC_CHECK_PAGES=20
PAGEINDEX_MAX_PAGES_PER_NODE=10
PAGEINDEX_MAX_TOKENS_PER_NODE=20000

# --- Security ---
# Leave empty to allow all local paths, or set allowed directories:
# PAGEINDEX_ALLOWED_ROOTS=/home/user/Documents:/home/user/Downloads

# --- Registry ---
PAGEINDEX_REGISTRY_BACKEND=json

# --- Logging ---
PAGEINDEX_LOG_LEVEL=info
